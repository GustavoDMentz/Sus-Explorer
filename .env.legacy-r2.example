# Ferramentas explícitas de migração/auditoria do espelho histórico R2 (não usadas pelo app).
# Copie para .env.legacy-r2 ou acrescente ao .env. Nunca coloque valores no código.
# O healthbr-data publica credenciais de leitura abertas; consulte o repositório de origem.
LEGACY_R2_ENDPOINT=
LEGACY_R2_ACCESS_KEY=
LEGACY_R2_SECRET_KEY=
LEGACY_R2_REGION=auto
LEGACY_R2_BUCKET=healthbr-data
LEGACY_R2_PREFIX=sipni/microdados

# Bucket de auditoria (sus-dados), com credenciais independentes.
LEGACY_AUDIT_R2_ENDPOINT=
LEGACY_AUDIT_R2_ACCESS_KEY_ID=
LEGACY_AUDIT_R2_SECRET_ACCESS_KEY=
LEGACY_AUDIT_R2_BUCKET=sus-dados
LEGACY_AUDIT_R2_CUBE_PREFIX=cache/pni_cube
