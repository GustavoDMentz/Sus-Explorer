# Local inference and documentary RAG
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_TIMEOUT=120
OLLAMA_EMBED_TIMEOUT=120
OLLAMA_KEEP_ALIVE=0
OLLAMA_MAX_CONCURRENT=1
OLLAMA_NUM_CTX=4096
OLLAMA_QUEUE_TIMEOUT=60

# RAG
RAG_EMBEDDING_DIM=1024
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.50
RAG_QUERY_INSTRUCTION=Given a question about the SUS Explorer documentation, retrieve passages that directly answer it.
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_CONTEXT_CHARS=3500

# PostgreSQL
POSTGRES_HISTORY_ENABLED=0
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sus_explorer
POSTGRES_USER=sus_explorer
POSTGRES_PASSWORD=

# Database profiles
POSTGRES_MIGRATOR_USER=sus_explorer_admin
POSTGRES_MIGRATOR_PASSWORD=

POSTGRES_INGEST_USER=sus_explorer_ingest
POSTGRES_INGEST_PASSWORD=

POSTGRES_HISTORY_USER=sus_explorer_hist
POSTGRES_HISTORY_PASSWORD=

POSTGRES_READER_USER=sus_explorer_app
POSTGRES_READER_PASSWORD=

POSTGRES_REQUIRE_PROFILES=1
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_LOCK_TIMEOUT_MS=5000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=30000
POSTGRES_APPLICATION_NAME=sus-explorer
POSTGRES_SCHEMA=sus_explorer
POSTGRES_SSLMODE=prefer

# Analytical history
ANALYTICAL_HISTORY_ENABLED=0
ANALYTICAL_HISTORY_KEY=
