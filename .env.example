# LLM planner/explainer. Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Analytical Parquet/R2 backend (unchanged and independently supported).
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=auto
R2_BUCKET=healthbr-data
R2_PREFIX=sipni/microdados

# Independent read-only audit bucket.
SUS_DATA_R2_ENDPOINT=
SUS_DATA_R2_ACCESS_KEY_ID=
SUS_DATA_R2_SECRET_ACCESS_KEY=
SUS_DATA_R2_BUCKET=sus-dados
SUS_DATA_R2_CUBE_PREFIX=cache/pni_cube

# Optional operational PostgreSQL backend.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sus_explorer
POSTGRES_USER=sus_explorer
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=10
