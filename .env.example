# LLM planner/explainer. Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Analytical Parquet/R2 backend (unchanged and independently supported).
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=auto
R2_BUCKET=healthbr-data
R2_PREFIX=sipni/microdados

# Independent read-only audit bucket.
SUS_DATA_R2_ENDPOINT=
SUS_DATA_R2_ACCESS_KEY_ID=
SUS_DATA_R2_SECRET_ACCESS_KEY=
SUS_DATA_R2_BUCKET=sus-dados
SUS_DATA_R2_CUBE_PREFIX=cache/pni_cube

# Optional operational PostgreSQL backend.
# Opt-in: bare monthly count uses PostgreSQL when exact R2 coverage is proven.
POSTGRES_COUNT_ENABLED=0
# Opt-in: store structured query metadata, without questions or result payloads.
POSTGRES_HISTORY_ENABLED=0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sus_explorer
POSTGRES_USER=sus_explorer
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_LOCK_TIMEOUT_MS=5000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=30000
POSTGRES_APPLICATION_NAME=sus-explorer
POSTGRES_SCHEMA=sus_explorer
# Use verify-full (plus trusted CA configuration) for remote production databases.
POSTGRES_SSLMODE=prefer

# Opt-in encrypted analytical result history (requires migration 005).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Keep key outside Git and backups. Losing the key makes historical snapshots unreadable.
ANALYTICAL_HISTORY_ENABLED=0
ANALYTICAL_HISTORY_KEY=

# External E2E canary is opt-in and must use a disposable *_test database.
# Set independently verified counts for two consecutive months; see README.
SUS_EXPLORER_EXTERNAL_TEST=0
SUS_EXPLORER_EXTERNAL_YEAR=
SUS_EXPLORER_EXTERNAL_MONTH=
SUS_EXPLORER_EXTERNAL_UF=
SUS_EXPLORER_EXTERNAL_COUNT=
SUS_EXPLORER_EXTERNAL_PREVIOUS_COUNT=
