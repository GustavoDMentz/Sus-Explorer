# Local inference and documentary RAG.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_TIMEOUT=120
OLLAMA_EMBED_TIMEOUT=120
OLLAMA_KEEP_ALIVE=0
OLLAMA_MAX_CONCURRENT=1
OLLAMA_NUM_CTX=4096
# Espera máxima (s) pela vez de inferência antes de responder "ocupado".
OLLAMA_QUEUE_TIMEOUT=60
# Só para um Ollama em outro computador: exige https e envia perguntas para fora desta máquina.
# OLLAMA_ALLOW_REMOTE=1
RAG_EMBEDDING_DIM=1024
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.65
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_CONTEXT_CHARS=3500

# Optional operational PostgreSQL backend.
# Opt-in: store structured query metadata, without questions or result payloads.
POSTGRES_HISTORY_ENABLED=0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sus_explorer
POSTGRES_USER=sus_explorer
POSTGRES_PASSWORD=
# Least-privilege logins (docs/postgres-roles.md). The passwords below are used by the compose
# bootstrap to create the roles on FIRST start; the users are fixed by the bootstrap script.
# The app uses the READER login, imports the INGEST login, the opt-in history the HISTORY login,
# and migrations/purge/RAG indexing the MIGRATOR login. POSTGRES_USER above stays for bootstrap only.
POSTGRES_MIGRATOR_USER=sus_explorer_admin
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_INGEST_USER=sus_explorer_ingest
POSTGRES_INGEST_PASSWORD=
POSTGRES_HISTORY_USER=sus_explorer_hist
POSTGRES_HISTORY_PASSWORD=
POSTGRES_READER_USER=sus_explorer_app
POSTGRES_READER_PASSWORD=
# 1 = refuse the legacy single login when a profile has no credentials (recommended once configured).
POSTGRES_REQUIRE_PROFILES=0
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_LOCK_TIMEOUT_MS=5000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=30000
POSTGRES_APPLICATION_NAME=sus-explorer
POSTGRES_SCHEMA=sus_explorer
# Host remoto exige require ou mais forte (o padrão passa a ser require); use verify-full
# (com a CA configurada) em produção. Em localhost o padrão continua prefer.
POSTGRES_SSLMODE=prefer

# Opt-in encrypted analytical result history (requires migration 005).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Keep key outside Git and backups. Losing the key makes historical snapshots unreadable.
ANALYTICAL_HISTORY_ENABLED=0
ANALYTICAL_HISTORY_KEY=
